# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGINS=http://localhost:5173

# MongoDB connection string. Atlas (cloud) or local MongoDB:
#   local: mongodb://127.0.0.1:27017/krishimitra
#   Atlas: add your IP under Network Access, and URL-encode special characters in the password
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/krishimitra

# Auth (use a long random string, e.g. `openssl rand -hex 48`)
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Share of each paid order kept by the platform, 0 to 50. Leave 0 until you decide a rate; sellers see it on Earnings.
PLATFORM_COMMISSION_PERCENT=0

# Optional integrations (features stay disabled until set)
GEMINI_API_KEY=
# Model used for plant disease photos. Check Google's current model list if requests fail.
GEMINI_MODEL=gemini-3.6-flash
# Live mandi prices. Free key from data.gov.in (My Account). Keep it only here; never put it in the frontend or in git.
DATA_GOV_API_KEY=
WEATHER_API_KEY=
CLOUDINARY_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set in Razorpay dashboard > Webhooks (URL: https://YOUR-API/api/payments/razorpay/webhook, events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=

# --- Sign-up / password-reset OTP -------------------------------------------------
# Mobile OTP. 'console' just prints the code in the backend terminal (development only; refused in production).
# For real SMS set SMS_PROVIDER=msg91 (India, needs an approved DLT OTP template) or SMS_PROVIDER=twilio.
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Email OTP (optional at signup, and used by "Forgot password" when the person types an email). Any SMTP account, e.g. Gmail app password, Brevo, SES.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=KrishiMitra AI <no-reply@yourdomain.com>

# --- Login / sign up with Google and Apple ---------------------------------------
# Google: Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web). Add your site URL under Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
# Apple: Apple Developer > Identifiers > Services ID (this is the client id) with Sign in with Apple enabled; add your domain and a Return URL.
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=
